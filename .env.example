# Server
PORT=8080
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/dopamine-db

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Set to true when serving over HTTPS
COOKIE_SECURE=false

# Comma-separated list of allowed origins for the SPA
CORS_ORIGIN=http://localhost:4200

# TMDB (https://www.themoviedb.org/settings/api) – v3 API key
TMDB_API_KEY=
TMDB_LANGUAGE=en-US
# ISO 3166-1 region used for "where to watch" data
TMDB_REGION=PL

# Optional: seed an admin account on first start
ADMIN_EMAIL=
ADMIN_PASSWORD=
